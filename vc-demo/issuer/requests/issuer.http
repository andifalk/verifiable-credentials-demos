@grantType = urn:ietf:params:oauth:grant-type:pre-authorized_code

### OpenID Credential Issuer metadata
# @name credentialIssuerMetadata
GET {{baseUrl}}/.well-known/openid-credential-issuer
Accept: application/json

> {%
    client.test("Credential issuer metadata is available", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.credential_issuer === request.environment.get("baseUrl"),
            "Unexpected credential issuer");
        client.assert(response.body.credential_endpoint === request.environment.get("baseUrl") + "/credential",
            "Unexpected credential endpoint");
    });
%}

### OAuth authorization server metadata
# @name authorizationServerMetadata
GET {{baseUrl}}/.well-known/oauth-authorization-server
Accept: application/json

> {%
    client.test("Authorization server metadata is available", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.token_endpoint === request.environment.get("baseUrl") + "/oauth2/token",
            "Unexpected token endpoint");
    });
%}

### SD-JWT VC issuer metadata
# @name jwtVcIssuerMetadata
GET {{baseUrl}}/.well-known/jwt-vc-issuer
Accept: application/json

> {%
    client.test("JWT VC issuer metadata is available", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(response.body.jwks_uri === request.environment.get("baseUrl") + "/jwks",
            "Unexpected JWKS URI");
    });
%}

### Issuer public keys
# @name jwks
GET {{baseUrl}}/jwks
Accept: application/json

> {%
    client.test("JWKS contains an issuer key", function () {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(Array.isArray(response.body.keys) && response.body.keys.length > 0,
            "Expected at least one public key");
    });
%}

