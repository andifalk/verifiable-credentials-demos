### OpenID4VP verifier metadata
GET {{verifierUrl}}/.well-known/openid4vp-verifier
Accept: application/json

> {%
  client.test("Verifier metadata is available", function () {
    client.assert(response.status === 200, "Expected HTTP 200");
    client.assert(response.body.client_id, "client_id is missing");
    client.assert(response.body.response_uris.length === 1, "Expected one response URI");
    client.assert(response.body.vp_formats_supported["dc+sd-jwt"], "SD-JWT format is missing");
  });
%}

